# Copy this file to .env and fill in your own values
# cp .env.example .env

# Your MongoDB Atlas connection string
# Get it from: Atlas Dashboard -> Clusters -> Connect -> Drivers -> Node.js -> copy string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stts?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/stts?retryWrites=true&w=majority&appName=Cluster0

# Secret key for JWT signing - use any long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-this-to-a-long-random-string

# Server port (Render/Railway/Heroku set this automatically)
PORT=8000
